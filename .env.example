# --- Runtime mode ---
NODE_ENV=development
AUTH_MODE=dev           # dev | production — dev bypasses magic-link, uses seeded admin

# --- Demo mode (locked 2026-05-26) ---
# Two clean states only:
#   AGENTIC_DEMO_MODE=false → production. ZERO mock/seed/synthetic data.
#                             Dashboard reflects only real events from the api.
#   AGENTIC_DEMO_MODE=true  → demo. Bootstrap runs `seed:rich` idempotently AND
#                             starts an in-process loop that fires plausible
#                             tenant events every 30s. The sidebar shows a
#                             lime "DEMO" badge. Use for screenshots, sales
#                             walkthroughs, design QA — never for prod.
AGENTIC_DEMO_MODE=false

# --- SQLite ---
DATABASE_URL=file:./agentic.db

# --- Inngest (ONE Inngest app per tenant) ---
# The platform __system app is served at /inngest (auto-discovered by the
# inngest-cli `-u .../inngest`); each tenant app `agentic-operator-<slug>` is
# served at /inngest/<slug> and PUT-self-synced to the Inngest server.
INNGEST_DEV=1
INNGEST_EVENT_KEY=local-dev-event-key
INNGEST_SIGNING_KEY=local-dev-signing-key
INNGEST_BASE_URL=http://localhost:8488
# Origin the per-tenant apps register their serve URL at (this api's port).
INNGEST_SERVE_ORIGIN=http://localhost:3540
# Periodic reconciler (ms) re-syncs apps the Inngest server forgot (e.g. after a
# dev-server restart). 0 disables. Do NOT set INNGEST_SERVE_PATH — servePath is
# a per-app explicit option; a process-wide value collapses every app onto one path.
INNGEST_RECONCILE_MS=60000

# --- Magic-link auth (production only) ---
RESEND_API_KEY=
AUTH_FROM_EMAIL=noreply@example.com
AUTH_SESSION_SECRET=change-me-in-production-32-bytes-min

# --- File storage roots ---
AGENTIC_LOGS_DIR=./logs
AGENTIC_ARTIFACTS_DIR=./artifacts

# --- Webhook HMAC secrets (per provider) ---
WEBHOOK_HMAC_SECRET_DEFAULT=local-dev-hmac

# --- LLM gateway defaults ---
# Falls back to `mock` if unset; mock never makes a real network call.
LLM_DEFAULT_PROVIDER=mock
LLM_DEFAULT_MODEL=
LLM_REQUEST_TIMEOUT_MS=60000

# --- Agent Factory model routing by task difficulty (#7) ---
# Each tier is a comma-separated fallback chain (preferred first). The chain is validated against
# the gateway's LIVE /models catalog (ids it doesn't serve are dropped); everything ultimately
# falls back to FACTORY_AI_MODEL / LLM_DEFAULT_MODEL so the brain always runs. Leave a tier BLANK
# to DERIVE it from the live catalog by preference patterns (fast→flash/haiku/mini, hard→sonnet/
# gpt-5/deepseek-pro …), overridable via FACTORY_MODEL_<TIER>_PREFER. The router picks fast for
# reading/planning, default for design, hard for code/refine, and a dedicated `review` tier for the
# AI quality-judge / failure-diagnosis / post-run scoring (strongest model). Use the real ids your
# gateway serves — example (New API catalog, 质量优先·混合):
# FACTORY_MODEL_FAST=google/gemini-3-flash-preview,anthropic/claude-haiku-4.5,deepseek/deepseek-v4-flash
# FACTORY_MODEL_DEFAULT=google/gemini-3.1-pro-preview-customtools,openai/gpt-5.4,anthropic/claude-sonnet-4.6
# FACTORY_MODEL_HARD=anthropic/claude-sonnet-4.6,moonshotai/kimi-k2.6,openai/gpt-5.4,anthropic/claude-opus-4.8
# FACTORY_MODEL_REVIEW=anthropic/claude-opus-4.8,openai/gpt-5.5,anthropic/claude-sonnet-4.6   # unset → uses HARD
FACTORY_MODEL_FAST=
FACTORY_MODEL_DEFAULT=
FACTORY_MODEL_HARD=
FACTORY_MODEL_REVIEW=

# #9 Brain language (i18n). zh (default — Chinese system prompt + roles + run-critic), en (English),
# or auto (follow the ontology/domain content's language). Lets the factory serve non-Chinese domains.
FACTORY_BRAIN_LANG=

# --- LLM provider API keys (leave blank for providers you don't use) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_REFERRER=http://localhost:3599
OPENROUTER_APP_TITLE=Agentic Operator
GOOGLE_API_KEY=
GROQ_API_KEY=
TOGETHER_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
QWEN_API_KEY=

# Azure OpenAI (needs all three)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-08-01-preview
AZURE_OPENAI_DEPLOYMENT=

# Custom OpenAI-compatible (e.g. self-hosted vLLM)
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_API_KEY=

# --- AllmetaOntology Studio (live ontology source — Neo4j 唯一入口) ---
# When ALLMETA_BASE_URL is set, the agent factory's ontology source becomes a
# composite: local models/<slug>/ domains PLUS live AllmetaOntology domains
# (e.g. "Agents-generation"), fetched over HTTP from the Studio API on every read.
# Leave ALLMETA_BASE_URL blank to disable (factory then only sees local domains).
# Live reads are STRICT: picking an Allmeta-only domain throws if Studio is
# unreachable (no snapshot fallback). API key = Studio's ONTOLOGY_API_TOKEN.
ALLMETA_BASE_URL=http://localhost:3500
ALLMETA_API_KEY=abc123
ALLMETA_TIMEOUT_MS=8000
