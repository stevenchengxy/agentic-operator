# --- Runtime mode ---
NODE_ENV=development
AUTH_MODE=dev           # dev | production — dev bypasses magic-link, uses seeded admin

# --- Demo mode (locked 2026-05-26) ---
# Two clean states only:
#   AGENTIC_DEMO_MODE=false → production. ZERO mock/seed/synthetic data.
#                             Dashboard reflects only real events from the api.
#   AGENTIC_DEMO_MODE=true  → demo. Bootstrap runs `seed:rich` idempotently AND
#                             starts an in-process loop that fires plausible
#                             tenant events every 30s. The sidebar shows a
#                             lime "DEMO" badge. Use for screenshots, sales
#                             walkthroughs, design QA — never for prod.
AGENTIC_DEMO_MODE=false

# --- SQLite ---
DATABASE_URL=file:./agentic.db

# --- Inngest ---
INNGEST_DEV=1
INNGEST_EVENT_KEY=local-dev-event-key
INNGEST_SIGNING_KEY=local-dev-signing-key
INNGEST_BASE_URL=http://localhost:8288

# --- Magic-link auth (production only) ---
RESEND_API_KEY=
AUTH_FROM_EMAIL=noreply@example.com
AUTH_SESSION_SECRET=change-me-in-production-32-bytes-min

# --- File storage roots ---
AGENTIC_LOGS_DIR=./logs
AGENTIC_ARTIFACTS_DIR=./artifacts

# --- Webhook HMAC secrets (per provider) ---
WEBHOOK_HMAC_SECRET_DEFAULT=local-dev-hmac

# --- LLM gateway defaults ---
# Falls back to `mock` if unset; mock never makes a real network call.
LLM_DEFAULT_PROVIDER=mock
LLM_DEFAULT_MODEL=
LLM_REQUEST_TIMEOUT_MS=60000

# --- LLM provider API keys (leave blank for providers you don't use) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_REFERRER=http://localhost:3599
OPENROUTER_APP_TITLE=Agentic Operator
GOOGLE_API_KEY=
GROQ_API_KEY=
TOGETHER_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=
ZAI_API_KEY=
QWEN_API_KEY=

# Azure OpenAI (needs all three)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-08-01-preview
AZURE_OPENAI_DEPLOYMENT=

# Custom OpenAI-compatible (e.g. self-hosted vLLM)
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_API_KEY=

# --- Agent Builder retrieval tools (optional) ---
# Deep Search uses Tavily by default. Set one provider key globally, or bind a
# tenant-prefixed *_env name in the agent's search.web tool config.
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
SERPER_API_KEY=
# Comma-separated host[:port] allow-list for explicitly configured search
# endpoints. Any endpoint override also requires a tenant-scoped api_key_env.
SEARCH_API_ALLOWED_HOSTS=

# Neo4j Query API v2. NEO4J_QUERY_API_URL may be an origin or the complete
# https://host/db/<database>/query/v2 URL. ontology.query is generated,
# parameterized, read-only, and always filters every node by tenant_slug.
NEO4J_QUERY_API_URL=
NEO4J_DATABASE=neo4j
NEO4J_USERNAME=
NEO4J_PASSWORD=
NEO4J_TENANT_PROPERTY=tenant_slug
NEO4J_ID_PROPERTY=id
# Server-owned retrieval/property policy. Endpoint overrides also require
# tenant-scoped credentials; accessMode=Read is not an authorization boundary.
NEO4J_QUERY_API_ALLOWED_HOSTS=
NEO4J_ALLOWED_DATABASES=neo4j
NEO4J_ALLOWED_PROPERTIES=id,slug,name,title,description,summary,content,type,status,category,score,confidence,created_at,updated_at
NEO4J_MAX_RESPONSE_BYTES=524288
