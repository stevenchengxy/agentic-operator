{
  "title": "Agentic Operator Workflow Manifest",
  "description": "Canonical shape of `models/<tenant>-v<n>/workflow_v*.json`. Generated from `packages/runtime/src/manifest.ts` (WorkflowManifestSchema). Some legacy on-disk shapes (eg `tool_use: \"\"`, array-of-strings tool refs, omitted `name`/`type`/`order` on actions) are tolerated by the runtime and accepted by this schema; the runtime normalizes them at parse time.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string"
      },
      "name": {
        "type": "string"
      },
      "title": {
        "type": "string"
      },
      "description": {
        "default": "",
        "type": "string"
      },
      "actor": {
        "minItems": 1,
        "type": "array",
        "items": {
          "type": "string",
          "enum": [
            "Agent",
            "Human"
          ]
        }
      },
      "trigger": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "actions": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "order": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "description": {
              "default": "",
              "type": "string"
            },
            "type": {
              "type": "string",
              "enum": [
                "tool",
                "logic",
                "manual",
                "condition",
                "delay",
                "subflow"
              ]
            },
            "action_prompt": {
              "type": "string"
            },
            "provider": {
              "type": "string",
              "enum": [
                "anthropic",
                "openai",
                "openrouter",
                "gemini",
                "mistral",
                "groq",
                "together",
                "deepseek",
                "moonshot",
                "zai",
                "qwen",
                "azure",
                "bedrock",
                "vertex",
                "custom",
                "mock"
              ]
            },
            "model": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            },
            "task_class": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[a-z][a-z0-9_-]*(?:\\.[a-z][a-z0-9_-]*)*$"
            },
            "reasoning": {
              "type": "object",
              "properties": {
                "effort": {
                  "type": "string",
                  "enum": [
                    "none",
                    "minimal",
                    "low",
                    "medium",
                    "high",
                    "xhigh",
                    "max"
                  ]
                },
                "mode": {
                  "type": "string",
                  "enum": [
                    "standard",
                    "pro"
                  ]
                },
                "summary": {
                  "type": "string",
                  "enum": [
                    "none",
                    "auto",
                    "concise",
                    "detailed"
                  ]
                },
                "context": {
                  "type": "string",
                  "enum": [
                    "auto",
                    "current_turn",
                    "all_turns"
                  ]
                }
              },
              "additionalProperties": false
            },
            "verbosity": {
              "type": "string",
              "enum": [
                "low",
                "medium",
                "high"
              ]
            },
            "store": {
              "type": "boolean"
            },
            "temperature": {
              "type": "number",
              "minimum": 0,
              "maximum": 2
            },
            "max_tokens": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 1048576
            },
            "tool": {
              "type": "string"
            },
            "condition": {
              "type": "string"
            },
            "true_action_id": {
              "type": "string"
            },
            "false_action_id": {
              "type": "string"
            },
            "task_type": {
              "type": "string"
            },
            "form_schema": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {}
            },
            "awaiting_role": {
              "type": "string"
            },
            "retries": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "timeout_s": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "delay_ms": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "subflow": {
              "type": "string"
            },
            "subflow_input": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {}
            },
            "wait_policy": {
              "type": "string",
              "enum": [
                "wait",
                "detach"
              ]
            },
            "input_mapping": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {}
            },
            "output_mapping": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {}
            }
          },
          "required": [],
          "additionalProperties": {},
          "description": "Step in an agent's action list. On disk either `id` or `order` must be present; missing `name` falls back to `id`/`order`, and missing `type` defaults to 'logic' at runtime.",
          "anyOf": [
            {
              "required": [
                "id"
              ]
            },
            {
              "required": [
                "order"
              ]
            }
          ]
        }
      },
      "triggered_event": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "input_data": {
        "type": "object",
        "propertyNames": {
          "type": "string"
        },
        "additionalProperties": {}
      },
      "ontology_instructions": {},
      "tool_use": {
        "description": "Tools advertised to the LLM. Canonical: array of {name, description?, input_schema?}. Runtime also accepts an array of bare tool-name strings, or an empty string as a no-tools placeholder.",
        "anyOf": [
          {
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "description": {
                      "type": "string"
                    },
                    "input_schema": {},
                    "config": {
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      },
                      "additionalProperties": {}
                    }
                  },
                  "required": [
                    "name"
                  ],
                  "additionalProperties": {}
                }
              },
              {}
            ]
          },
          {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          {
            "type": "string",
            "maxLength": 0
          }
        ]
      },
      "typescript_code": {},
      "generated": {
        "type": "boolean"
      },
      "task_class": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[a-z][a-z0-9_-]*(?:\\.[a-z][a-z0-9_-]*)*$"
      },
      "cron": {},
      "cron_timezone": {}
    },
    "required": [
      "id",
      "name",
      "description",
      "actor",
      "trigger",
      "actions",
      "triggered_event"
    ],
    "additionalProperties": {}
  }
}
