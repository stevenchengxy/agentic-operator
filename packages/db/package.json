{
  "name": "@agentic/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts",
    "./client": "./src/client.ts"
  },
  "scripts": {
    "backup": "node --import tsx ../../apps/api/scripts/sqlite-writer-supervisor.ts --db-command backup",
    "generate": "drizzle-kit generate",
    "migrate": "node --import tsx ../../apps/api/scripts/sqlite-writer-supervisor.ts --migrate-only",
    "seed": "node --import tsx ../../apps/api/scripts/sqlite-writer-supervisor.ts --db-command seed",
    "wipe-runtime": "node --import tsx ../../apps/api/scripts/sqlite-writer-supervisor.ts --db-command wipe-runtime",
    "prune-deployments": "node --import tsx ../../apps/api/scripts/sqlite-writer-supervisor.ts --db-command prune-deployments",
    "studio": "node --import tsx ../../apps/api/scripts/sqlite-writer-supervisor.ts --db-command studio",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo drizzle/*.sql"
  },
  "dependencies": {
    "@agentic/shared": "workspace:*",
    "better-sqlite3": "^12.10.0",
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.22.0",
    "typescript": "^6.0.3"
  }
}
